# Chave da sua Evolution API (a mesma AUTHENTICATION_API_KEY dela)
EVOLUTION_API_KEY=troque-esta-chave

# Segredo que faz parte da URL do webhook; impede que terceiros enviem mensagens falsas ao bot
WEBHOOK_TOKEN=troque-este-token

# Números que o bot responde, separados por vírgula, no formato do WhatsApp (DDI + DDD + número).
# Deixe vazio para responder todos. Se um número for ignorado, o log do bot mostra o formato exato
# (alguns celulares antigos aparecem sem o 9: 551188887777).
ALLOWED_NUMBERS=5511999999999

# Modelo do Ollama que responde os clientes
OLLAMA_MODEL=qwen3:4b-instruct

# Onde estão a Evolution API e o Redis já existentes (valores padrão do projeto Automacao)
# EVOLUTION_NETWORK=venv_evolution-net
# EVOLUTION_URL=http://evolution_api:8080
# REDIS_URL=redis://redis:6379/3
